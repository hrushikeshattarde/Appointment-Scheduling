# The board's settings on the server. Copy to deploy/aws/settings.env (git-ignored), fill it in,
# and load it with deploy/aws/put-settings.ps1: each line becomes a Parameter Store parameter
# /pickup-booking/<NAME>, the secrets encrypted (SecureString). The server reads them at every
# start (deploy/fetch-env.sh); change one and restart the board to apply it.

# --- Transport Pro (the username and password are stored encrypted)
TPRO_BASE_URL=https://api.example.transportpro.net
TPRO_USERNAME=
TPRO_PASSWORD=

# --- Claude on Amazon Bedrock (the server's IAM role signs the calls; no key)
FP_LLM_PROVIDER=bedrock
FP_LLM_MODEL=claude-sonnet-5-5
FP_BEDROCK_REGION=us-east-1
FP_BEDROCK_ROUTING=us

# --- Board sign-in (Google; the client secret and session secret are stored encrypted)
FP_GOOGLE_CLIENT_ID=
FP_GOOGLE_CLIENT_SECRET=
FP_BOARD_SESSION_SECRET=
FP_BOARD_ADMINS=hrushikesh.attarde@circledelivers.com
FP_BOARD_PUBLIC_URL=https://pickups.circle-analytics.com

# --- Mail, Transport Pro checks and write-back
# Lidl's mail: the lidl@ group archive the collector Lambda keeps. booking@circle-analytics.com's
# folder is ses://trucklists/pickup-booking.
FP_BOOKING_INBOX=s3://circle-lidl-appointments
FP_BOOKING_DAYS_AHEAD=14
# Off for the first days: the server runs read-only next to the laptop board. Turn it on (true)
# to have booked times written to Transport Pro.
FP_BOOKING_TPRO_WRITEBACK=false
SCAN_CUSTOMERS=lidl
SCAN_EVERY=30
MAIL_EVERY=5
WRITEBACK_EVERY=1
TIMERS_EVERY=15
FP_LOG_JSON=true
