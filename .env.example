# Copy to .env and fill in. Never commit .env.
# Same variable names as the Transport Pro MCP server so one .env serves both.

# --- Transport Pro Public API -------------------------------------------
TPRO_BASE_URL=https://api.example.transportpro.net   # no trailing slash
TPRO_USERNAME=api-user
TPRO_PASSWORD=change-me
TPRO_TIMEOUT_MS=30000
TPRO_MAX_REQUESTS_PER_SECOND=5

# --- LLM -----------------------------------------------------------------------------
# Provider: anthropic (direct API, uses ANTHROPIC_API_KEY or an `ant auth login` profile)
#           openrouter (OpenAI-compatible gateway, uses OPENROUTER_API_KEY)
FP_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...
# Bare Anthropic model names are prefixed with anthropic/ for OpenRouter automatically.
FP_LLM_MODEL=claude-opus-5
FP_LLM_MAX_TOKENS=16000
# Optional hard stop on estimated LLM spend per run (USD); also available as `run --budget`.
# FP_LLM_BUDGET_USD=3

# --- Storage -------------------------------------------------------------------
# SQLite for the pilot; swap for postgresql+psycopg://user:pass@host/db in production.
FP_DATABASE_URL=sqlite:///./data/facility_profiles.db

# --- Run controls --------------------------------------------------------------
FP_MODE=recommend            # recommend | write
# --- Customers (src/facility_profiles/customers/*.toml; README "Customers") --------
# FP_CUSTOMERS=lidl                 # the pod's customers: harvest, run and scan default to their records and pods
# FP_CUSTOMERS_DIR=../customer-files   # more customer files, e.g. outside the public repository
FP_PILOT_TERMINAL_IDS=1160   # comma-separated Transport Pro terminal IDs
# FP_PILOT_CUSTOMER_IDS=6680,7211   # optional: only loads billed to these customers
FP_FACILITY_CAP=500
FP_LOOKBACK_DAYS=90
FP_MAX_LOADS_PER_FACILITY=100
FP_WRITE_THRESHOLD=0.8
FP_QUEUE_THRESHOLD=0.5
FP_CONFLICT_SUPPORT=0.3
FP_STALE_AFTER_DAYS=180
FP_LOG_LEVEL=INFO

# --- Booking agent prototype (draft mode only) -------------------------------------
# FP_BOOKING_DAYS_AHEAD=7                 # pickup window scanned for open cases
# FP_BOOKING_DEFAULT_PICKUP_TIME=09:00    # slot requested when the tender gives none and the facility has no usual time
# FP_BOOKING_EARLIEST_PICKUP_TIME=05:00   # without the facility's hours, never ask for a pickup earlier than this
# FP_BOOKING_TRANSIT_MILES_PER_DAY=600    # a truck's miles a day: the pickup day counts back from the delivery by it, and longer trips stop for the rest of each 24 hours
# FP_BOOKING_WATCH_BOOKED=false          # after-booking checks (carrier, truck, carrier's steps); off for now
# FP_BOOKING_CARRIER_BY=12:00            # a booked pickup with no carrier by this time ET, the business day before: "No carrier yet"
# FP_BOOKING_NO_SHOW_HOURS=2              # hours after a booked time with no arrival at the shipper: "Truck not seen at pickup"
# Sender, cc, signature and customer desk come from each customer's file; these four apply only
# to a load billed to a customer that has no file (by default: no From, no cc, no desk).
# FP_BOOKING_SENDER=
# FP_BOOKING_CC=
# FP_BOOKING_SIGNATURE=Circle Logistics, Inc. | Fort Wayne | 260-208-4500
# FP_BOOKING_CUSTOMER_DESK=
# FP_BOOKING_DRAFTS_DIR=./exports/drafts
# FP_BOOKING_MODE=draft                   # draft | send (send lets `booking send` deliver through Gmail)
# FP_BOOKING_GMAIL_KEY=./service-account.json   # gmail.send delegation for the mailbox below
# FP_BOOKING_GMAIL_USER=member@circledelivers.com  # the mailbox the agent sends as (a group member)
# FP_BOOKING_SEND_DAILY_CAP=20            # outbound sends per rolling 24 hours
# FP_BOOKING_PO_DATE_FLOOR_DESKS=           # desks never asked before the PO's date (none: the PO date is not reliable)
# FP_BOOKING_TIMEZONE=America/New_York   # the pod's time zone: "today" in `booking today`
# Click-to-confirm links (off until both are set; README "Click-to-confirm links"):
# FP_BOOKING_LINK_BASE_URL=https://book.example.com   # public address of `serve-links`
# FP_BOOKING_LINK_SECRET=                             # long random string; signs the links
# FP_BOOKING_LINK_OFFSETS_MINUTES=-60,0,60,120        # times offered around the one asked for
# FP_BOOKING_LINK_VALID_HOURS=72                      # weekday hours; never past the last time offered
# FP_BOOKING_LINK_AUTO_SCHEDULE=true                  # false: a picked time waits for approval
# FP_BOOKING_TPRO_WRITEBACK=false   # true: booked pickups are written to Transport Pro (booking writeback)
# FP_BOOKING_INBOX=gmail            # the agent reads and answers replies on each pass: gmail, s3://bucket/prefix or ses://bucket/prefix (booking@circle-analytics.com: ses://trucklists/pickup-booking)
# FP_BOOKING_INBOX_DAYS=2           # how far back each pass reads (mail already read is skipped)

# --- Appointments board sign-in (README "Who sees which customer") ------------------------------
# Google sign-in is on when both are set; then people see only the customers an admin gave them.
# Unset: no login, so keep `serve` on 127.0.0.1.
# FP_GOOGLE_CLIENT_ID=...apps.googleusercontent.com
# FP_GOOGLE_CLIENT_SECRET=
# FP_BOARD_ADMINS=you@circledelivers.com     # comma-separated; see every customer and give access
# FP_BOARD_DOMAINS=circledelivers.com        # Google Workspace domains that may sign in
# FP_BOARD_SESSION_HOURS=8
# FP_BOARD_PUBLIC_URL=https://board.example  # the address people open, when a proxy changes it
# FP_BOARD_SESSION_SECRET=                   # unset: made on first start and kept in the store

# --- Group-mail archive in S3 (Pick Up Appointment threads) ---------------------------------
# FP_MAIL_ARCHIVE_BUCKET=circle-lidl-appointments
# FP_MAIL_ARCHIVE_PREFIX=
# FP_MAIL_ARCHIVE_GMAIL_USER=member@circledelivers.com   # group member whose mailbox holds the group's mail
FP_LOG_JSON=false
