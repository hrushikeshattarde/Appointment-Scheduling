# Copy to .env and fill in. Never commit .env.
# Same variable names as the Transport Pro MCP server so one .env serves both.

# --- Transport Pro Public API -------------------------------------------
TPRO_BASE_URL=https://api.example.transportpro.net   # no trailing slash
TPRO_USERNAME=api-user
TPRO_PASSWORD=change-me
TPRO_TIMEOUT_MS=30000
TPRO_MAX_REQUESTS_PER_SECOND=5

# --- LLM -----------------------------------------------------------------------------
# Provider: anthropic (direct API, uses ANTHROPIC_API_KEY or an `ant auth login` profile)
#           openrouter (OpenAI-compatible gateway, uses OPENROUTER_API_KEY)
FP_LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# ANTHROPIC_API_KEY=sk-ant-...
# Bare Anthropic model names are prefixed with anthropic/ for OpenRouter automatically.
FP_LLM_MODEL=claude-opus-5
FP_LLM_MAX_TOKENS=16000
# Optional hard stop on estimated LLM spend per run (USD); also available as `run --budget`.
# FP_LLM_BUDGET_USD=3

# --- Storage -------------------------------------------------------------------
# SQLite for the pilot; swap for postgresql+psycopg://user:pass@host/db in production.
FP_DATABASE_URL=sqlite:///./data/facility_profiles.db

# --- Run controls --------------------------------------------------------------
FP_MODE=recommend            # recommend | write
FP_PILOT_TERMINAL_IDS=1160   # comma-separated Transport Pro terminal IDs
FP_FACILITY_CAP=500
FP_LOOKBACK_DAYS=90
FP_MAX_LOADS_PER_FACILITY=100
FP_WRITE_THRESHOLD=0.8
FP_QUEUE_THRESHOLD=0.5
FP_CONFLICT_SUPPORT=0.3
FP_STALE_AFTER_DAYS=180
FP_LOG_LEVEL=INFO
FP_LOG_JSON=false
